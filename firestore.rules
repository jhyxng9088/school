rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validReminderSummary() {
      return !request.resource.data.keys().hasAny(['summary'])
        || (request.resource.data.summary is map
          && request.resource.data.summary.keys().hasOnly(['overview', 'sections'])
          && request.resource.data.summary.keys().hasAll(['overview', 'sections'])
          && request.resource.data.summary.overview is string
          && request.resource.data.summary.overview.size() <= 2400
          && request.resource.data.summary.sections is list
          && request.resource.data.summary.sections.size() <= 14);
    }

    function validReminderAttachment() {
      return !request.resource.data.keys().hasAny(['attachment'])
        || (request.resource.data.attachment is map
          && request.resource.data.attachment.keys().hasOnly(['name', 'mimeType', 'size'])
          && request.resource.data.attachment.keys().hasAll(['name', 'mimeType', 'size'])
          && request.resource.data.attachment.name is string
          && request.resource.data.attachment.name.size() > 0
          && request.resource.data.attachment.name.size() <= 120
          && request.resource.data.attachment.mimeType in [
            'application/pdf', 'application/json', 'text/plain', 'text/csv', 'text/rtf',
            'text/html', 'text/xml', 'image/jpeg', 'image/png', 'image/webp', 'image/bmp',
            'image/heic', 'image/heif'
          ]
          && request.resource.data.attachment.size is int
          && request.resource.data.attachment.size > 0
          && request.resource.data.attachment.size <= 2500000);
    }

    function validReminder(todoId) {
      return request.resource.data.keys().hasOnly([
          'id', 'type', 'title', 'dueDate', 'dueTime', 'createdAt', 'updatedAt',
          'summary', 'attachment'
        ])
        && request.resource.data.id == todoId
        && (request.resource.data.type in ['task', 'performance', 'exam', 'material']
          || request.resource.data.type.matches('^custom-[0-9a-f]{6}$'))
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.dueTime is string
        && (request.resource.data.dueTime == ''
          || request.resource.data.dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && validReminderSummary()
        && validReminderAttachment();
    }

    // Timed reminders expire at their exact KST due minute.
    // Untimed reminders expire at 23:59:59 KST on their due date.
    function reminderExpiredInKorea() {
      let due = resource.data.dueDate;
      let dueTime = resource.data.dueTime;
      let kstNow = request.time + duration.value(9, 'h');
      let dueYear = int(due[0:4]);
      let dueMonth = int(due[5:7]);
      let dueDay = int(due[8:10]);
      let sameDay = kstNow.year() == dueYear
        && kstNow.month() == dueMonth
        && kstNow.day() == dueDay;
      let datePassed = kstNow.year() > dueYear
        || (kstNow.year() == dueYear && kstNow.month() > dueMonth)
        || (kstNow.year() == dueYear && kstNow.month() == dueMonth && kstNow.day() > dueDay);
      let timedExpired = dueTime is string
        && dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && sameDay
        && (kstNow.hours() > int(dueTime[0:2])
          || (kstNow.hours() == int(dueTime[0:2])
            && kstNow.minutes() >= int(dueTime[3:5])));
      return due is string
        && due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (datePassed
          || (dueTime == ''
            && sameDay
            && kstNow.hours() == 23
            && kstNow.minutes() == 59
            && kstNow.seconds() >= 59)
          || timedExpired);
    }

    // Custom academic events remain through their end date and may be cleaned
    // up from the following KST calendar day. NEIS data is not stored here.
    function academicExpiredInKorea() {
      let endDate = resource.data.endDate;
      let kstNow = request.time + duration.value(9, 'h');
      let endYear = int(endDate[0:4]);
      let endMonth = int(endDate[5:7]);
      let endDay = int(endDate[8:10]);
      let datePassed = kstNow.year() > endYear
        || (kstNow.year() == endYear && kstNow.month() > endMonth)
        || (kstNow.year() == endYear && kstNow.month() == endMonth && kstNow.day() > endDay);
      return endDate is string
        && endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && datePassed;
    }

    function validTimetable() {
      return request.resource.data.keys().hasOnly(['weeklySchedule', 'overrides', 'updatedAt'])
        && request.resource.data.keys().hasAll(['updatedAt'])
        && request.resource.data.get('weeklySchedule', {}) is map
        && request.resource.data.get('overrides', {}) is map
        && request.resource.data.updatedAt is int
        && request.resource.data.keys().hasAny(['weeklySchedule', 'overrides']);
    }

    function validMember() {
      return request.resource.data.keys().hasOnly(['joinedAt'])
        && request.resource.data.keys().hasAll(['joinedAt'])
        && request.resource.data.joinedAt is int;
    }

    function validPresence() {
      return request.resource.data.keys().hasOnly(['studentKey', 'lastSeenMs'])
        && request.resource.data.keys().hasAll(['studentKey', 'lastSeenMs'])
        && request.resource.data.studentKey is string
        && request.resource.data.studentKey.size() >= 16
        && request.resource.data.studentKey.size() <= 80
        && request.resource.data.lastSeenMs is int;
    }

    function validOriginalAttachment() {
      return request.resource.data.keys().hasOnly(['name', 'mimeType', 'size', 'chunkCount', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'mimeType', 'size', 'chunkCount', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.mimeType in [
          'application/pdf', 'application/json', 'text/plain', 'text/csv', 'text/rtf',
          'text/html', 'text/xml', 'image/jpeg', 'image/png', 'image/webp', 'image/bmp',
          'image/heic', 'image/heif'
        ]
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 8000000
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount > 0
        && request.resource.data.chunkCount <= 24
        && request.resource.data.createdAt is int;
    }

    function validOriginalChunk() {
      return request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.keys().hasAll(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 600000;
    }

    function validUserIdentity() {
      return request.resource.data.keys().hasOnly(['classId', 'studentKey', 'name', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['classId', 'studentKey', 'name', 'createdAt', 'updatedAt'])
        && request.resource.data.classId is string
        && request.resource.data.classId.size() >= 7
        && request.resource.data.classId.size() <= 20
        && request.resource.data.studentKey is string
        && request.resource.data.studentKey.size() >= 16
        && request.resource.data.studentKey.size() <= 80
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;
    }

    function belongsToClass(classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classId == classId;
    }

    function isCurrentStudent(studentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentKey == studentId;
    }

    function validActivity() {
      return request.resource.data.keys().hasOnly(['entityType', 'entityId', 'actorName', 'actorStudentKey', 'action', 'updatedAt'])
        && request.resource.data.keys().hasAll(['entityType', 'entityId', 'actorName', 'actorStudentKey', 'action', 'updatedAt'])
        && request.resource.data.entityType in ['reminder', 'timetable', 'academic']
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() > 0
        && request.resource.data.entityId.size() <= 120
        && request.resource.data.actorName is string
        && request.resource.data.actorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.actorStudentKey == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentKey
        && request.resource.data.action in ['added', 'edited']
        && request.resource.data.updatedAt is int;
    }

    function validAcademicEvent(eventId) {
      return request.resource.data.keys().hasOnly([
          'id', 'title', 'startDate', 'endDate', 'detail', 'createdAt', 'updatedAt',
          'creatorStudentKey', 'creatorName', 'lastEditedByStudentKey', 'lastEditedByName', 'lastAction'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'title', 'startDate', 'endDate', 'detail', 'createdAt', 'updatedAt',
          'creatorStudentKey', 'creatorName', 'lastEditedByStudentKey', 'lastEditedByName', 'lastAction'
        ])
        && request.resource.data.id == eventId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.startDate is string
        && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.endDate is string
        && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.endDate >= request.resource.data.startDate
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 500
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.creatorStudentKey is string
        && request.resource.data.creatorName is string
        && request.resource.data.lastEditedByStudentKey is string
        && request.resource.data.lastEditedByName is string
        && request.resource.data.lastAction in ['added', 'edited'];
    }

    function validPersonalTodoState() {
      return request.resource.data.keys().hasOnly(['completed', 'hidden', 'updatedAt'])
        && request.resource.data.keys().hasAll(['completed', 'hidden', 'updatedAt'])
        && request.resource.data.completed is bool
        && request.resource.data.hidden is bool
        && request.resource.data.updatedAt is int;
    }

    function validReminderCategory(categoryId) {
      return request.resource.data.keys().hasOnly(['id', 'label', 'color', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['id', 'label', 'color', 'createdAt', 'updatedAt'])
        && request.resource.data.id == categoryId
        && categoryId.matches('^custom-[0-9a-f]{6}$')
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 16
        && request.resource.data.color in [
          '#d68a45', '#3f91c7', '#9b6fd0', '#d85b91',
          '#38a6a6', '#a77851', '#78a947', '#b8615c'
        ]
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;
    }

    function validPushSubscription() {
      return request.resource.data.keys().hasOnly([
          'studentKey', 'deviceId', 'endpoint', 'p256dh', 'auth', 'userAgent', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'studentKey', 'deviceId', 'endpoint', 'p256dh', 'auth', 'userAgent', 'updatedAt'
        ])
        && request.resource.data.studentKey is string
        && request.resource.data.studentKey.size() >= 16
        && request.resource.data.studentKey.size() <= 80
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() >= 12
        && request.resource.data.deviceId.size() <= 48
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() >= 20
        && request.resource.data.endpoint.size() <= 2000
        && request.resource.data.p256dh is string
        && request.resource.data.p256dh.size() >= 20
        && request.resource.data.p256dh.size() <= 300
        && request.resource.data.auth is string
        && request.resource.data.auth.size() >= 8
        && request.resource.data.auth.size() <= 200
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 350
        && request.resource.data.updatedAt is int;
    }

    function validPushDispatchClaim() {
      return request.resource.data.keys().hasOnly(['kind', 'actorStudentKey', 'createdAt'])
        && request.resource.data.keys().hasAll(['kind', 'actorStudentKey', 'createdAt'])
        && request.resource.data.kind == 'activity'
        && request.resource.data.actorStudentKey is string
        && request.resource.data.actorStudentKey.size() >= 3
        && request.resource.data.actorStudentKey.size() <= 80
        && request.resource.data.createdAt is int;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && validUserIdentity();
      allow update: if signedIn()
        && request.auth.uid == uid
        && validUserIdentity()
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.studentKey == resource.data.studentKey
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /classes/{classId}/activity/{activityId} {
      allow read: if belongsToClass(classId);
      allow create, update: if belongsToClass(classId) && validActivity();
      allow delete: if false;
    }

    // Student-created academic events only. NEIS schedules never use this path.
    match /classes/{classId}/academicEvents/{eventId} {
      allow read: if belongsToClass(classId);
      allow create: if belongsToClass(classId)
        && validAcademicEvent(eventId)
        && request.resource.data.creatorStudentKey == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentKey
        && request.resource.data.creatorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.lastEditedByStudentKey == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentKey
        && request.resource.data.lastEditedByName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.lastAction == 'added';
      allow update: if belongsToClass(classId)
        && validAcademicEvent(eventId)
        && request.resource.data.creatorStudentKey == resource.data.creatorStudentKey
        && request.resource.data.creatorName == resource.data.creatorName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastEditedByStudentKey == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentKey
        && request.resource.data.lastEditedByName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.lastAction == 'edited';
      allow delete: if belongsToClass(classId)
        && (resource.data.creatorStudentKey == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentKey
          || academicExpiredInKorea());
    }

    match /classes/{classId}/todos/{todoId} {
      allow read: if belongsToClass(classId);
      allow create: if belongsToClass(classId) && validReminder(todoId);
      allow update: if belongsToClass(classId)
        && validReminder(todoId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if belongsToClass(classId) && reminderExpiredInKorea();
    }

    match /classes/{classId}/reminderCategories/{categoryId} {
      allow read: if belongsToClass(classId);
      allow create: if belongsToClass(classId) && validReminderCategory(categoryId);
      allow update: if belongsToClass(classId)
        && validReminderCategory(categoryId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /classes/{classId}/settings/timetable {
      allow read: if belongsToClass(classId);
      allow create, update: if belongsToClass(classId) && validTimetable();
      allow delete: if false;
    }

    match /classes/{classId}/members/{studentId} {
      allow read: if belongsToClass(classId);
      allow create, update: if belongsToClass(classId)
        && isCurrentStudent(studentId)
        && validMember();
      allow delete: if false;
    }

    match /classes/{classId}/presence/{presenceId} {
      allow read: if belongsToClass(classId);
      allow create, update: if belongsToClass(classId)
        && isCurrentStudent(presenceId)
        && presenceId == request.resource.data.studentKey
        && validPresence();
      allow delete: if false;
    }

    // Scheduled push backends use Firebase Admin SDK and bypass client rules.
    // A client may only read/write its own subscription inside its class.
    match /classes/{classId}/pushSubscriptions/{subscriptionId} {
      allow read: if belongsToClass(classId)
        && resource.data.studentKey == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentKey;
      allow create, update: if belongsToClass(classId)
        && validPushSubscription()
        && request.resource.data.studentKey == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentKey;
      allow delete: if belongsToClass(classId)
        && resource.data.studentKey == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentKey;
    }

    match /classes/{classId}/pushDispatchClaims/{claimId} {
      allow read: if belongsToClass(classId);
      allow create: if belongsToClass(classId)
        && validPushDispatchClaim()
        && request.resource.data.actorStudentKey == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentKey;
      allow update: if false;
      allow delete: if belongsToClass(classId)
        && resource.data.kind == 'activity'
        && resource.data.actorStudentKey == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentKey;
    }

    match /classes/{classId}/originalAttachments/{todoId} {
      allow read: if belongsToClass(classId);
      allow create, update: if belongsToClass(classId) && validOriginalAttachment();
      allow delete: if false;
    }

    match /classes/{classId}/originalAttachments/{todoId}/chunks/{chunkId} {
      allow read: if belongsToClass(classId);
      allow create, update: if belongsToClass(classId) && validOriginalChunk();
      allow delete: if false;
    }

    match /students/{studentId}/todoState/{todoId} {
      allow read: if isCurrentStudent(studentId);
      allow create, update: if isCurrentStudent(studentId) && validPersonalTodoState();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
