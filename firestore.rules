rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validAudit(audit) {
      return audit is map
        && audit.keys().hasOnly(['name', 'studentKey', 'action', 'updatedAt'])
        && audit.keys().hasAll(['name', 'studentKey', 'action', 'updatedAt'])
        && audit.name is string
        && audit.name.size() > 0
        && audit.name.size() <= 20
        && audit.studentKey is string
        && audit.studentKey.size() >= 16
        && audit.studentKey.size() <= 80
        && audit.action in ['added', 'modified']
        && audit.updatedAt is int;
    }

    function validReminderSummary() {
      return !request.resource.data.keys().hasAny(['summary'])
        || (request.resource.data.summary is map
          && request.resource.data.summary.keys().hasOnly(['overview', 'sections'])
          && request.resource.data.summary.keys().hasAll(['overview', 'sections'])
          && request.resource.data.summary.overview is string
          && request.resource.data.summary.overview.size() <= 2400
          && request.resource.data.summary.sections is list
          && request.resource.data.summary.sections.size() <= 14);
    }

    function validReminderAttachment() {
      return !request.resource.data.keys().hasAny(['attachment'])
        || (request.resource.data.attachment is map
          && request.resource.data.attachment.keys().hasOnly(['name', 'mimeType', 'size'])
          && request.resource.data.attachment.keys().hasAll(['name', 'mimeType', 'size'])
          && request.resource.data.attachment.name is string
          && request.resource.data.attachment.name.size() > 0
          && request.resource.data.attachment.name.size() <= 120
          && request.resource.data.attachment.mimeType in [
            'application/pdf', 'application/json', 'text/plain', 'text/csv', 'text/rtf',
            'text/html', 'text/xml', 'image/jpeg', 'image/png', 'image/webp', 'image/bmp',
            'image/heic', 'image/heif'
          ]
          && request.resource.data.attachment.size is int
          && request.resource.data.attachment.size > 0
          && request.resource.data.attachment.size <= 2500000);
    }

    function validReminder(todoId) {
      return request.resource.data.keys().hasOnly([
          'id', 'type', 'title', 'dueDate', 'dueTime', 'createdAt', 'updatedAt',
          'summary', 'attachment', 'audit'
        ])
        && request.resource.data.id == todoId
        && request.resource.data.type in ['task', 'performance', 'exam', 'material']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.size() == 10
        && request.resource.data.dueTime is string
        && request.resource.data.dueTime.size() <= 5
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && (!request.resource.data.keys().hasAny(['audit']) || validAudit(request.resource.data.audit))
        && validReminderSummary()
        && validReminderAttachment();
    }

    function validTimetable() {
      return request.resource.data.keys().hasOnly(['weeklySchedule', 'overrides', 'weeklyMeta', 'overrideMeta', 'updatedAt'])
        && request.resource.data.keys().hasAll(['updatedAt'])
        && request.resource.data.get('weeklySchedule', {}) is map
        && request.resource.data.get('overrides', {}) is map
        && request.resource.data.get('weeklyMeta', {}) is map
        && request.resource.data.get('overrideMeta', {}) is map
        && request.resource.data.updatedAt is int
        && request.resource.data.keys().hasAny(['weeklySchedule', 'overrides']);
    }

    function validMember() {
      return request.resource.data.keys().hasOnly(['joinedAt'])
        && request.resource.data.keys().hasAll(['joinedAt'])
        && request.resource.data.joinedAt is int;
    }

    function validPresence() {
      return request.resource.data.keys().hasOnly(['studentKey', 'lastSeenMs'])
        && request.resource.data.keys().hasAll(['studentKey', 'lastSeenMs'])
        && request.resource.data.studentKey is string
        && request.resource.data.studentKey.size() >= 16
        && request.resource.data.studentKey.size() <= 80
        && request.resource.data.lastSeenMs is int;
    }

    function validOriginalAttachment() {
      return request.resource.data.keys().hasOnly(['name', 'mimeType', 'size', 'chunkCount', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'mimeType', 'size', 'chunkCount', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.mimeType in [
          'application/pdf', 'application/json', 'text/plain', 'text/csv', 'text/rtf',
          'text/html', 'text/xml', 'image/jpeg', 'image/png', 'image/webp', 'image/bmp',
          'image/heic', 'image/heif'
        ]
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 8000000
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount > 0
        && request.resource.data.chunkCount <= 24
        && request.resource.data.createdAt is int;
    }

    function validOriginalChunk() {
      return request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.keys().hasAll(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 600000;
    }

    function validIdentity() {
      return request.resource.data.keys().hasOnly(['studentKey', 'classId', 'name', 'updatedAt'])
        && request.resource.data.keys().hasAll(['studentKey', 'classId', 'name', 'updatedAt'])
        && request.resource.data.studentKey is string
        && request.resource.data.studentKey.size() >= 16
        && request.resource.data.studentKey.size() <= 80
        && request.resource.data.classId is string
        && request.resource.data.classId.size() > 0
        && request.resource.data.classId.size() <= 40
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.updatedAt is int;
    }

    function sameStudentIdentity(studentKey, classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/identities/$(request.auth.uid))
        && get(/databases/$(database)/documents/identities/$(request.auth.uid)).data.studentKey == studentKey
        && get(/databases/$(database)/documents/identities/$(request.auth.uid)).data.classId == classId;
    }

    function validAcademicEvent(eventId) {
      return request.resource.data.keys().hasOnly([
          'id', 'name', 'startDate', 'endDate', 'createdByName', 'createdByStudentKey',
          'createdAt', 'updatedAt', 'audit'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'name', 'startDate', 'endDate', 'createdByName', 'createdByStudentKey',
          'createdAt', 'updatedAt', 'audit'
        ])
        && request.resource.data.id == eventId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.startDate is string
        && request.resource.data.startDate.size() == 10
        && request.resource.data.endDate is string
        && request.resource.data.endDate.size() == 10
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 20
        && request.resource.data.createdByStudentKey is string
        && request.resource.data.createdByStudentKey.size() >= 16
        && request.resource.data.createdByStudentKey.size() <= 80
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && validAudit(request.resource.data.audit);
    }

    function validPersonalTodoState() {
      return request.resource.data.keys().hasOnly(['completed', 'hidden', 'updatedAt'])
        && request.resource.data.keys().hasAll(['completed', 'hidden', 'updatedAt'])
        && request.resource.data.completed is bool
        && request.resource.data.hidden is bool
        && request.resource.data.updatedAt is int;
    }

    match /identities/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && uid == request.auth.uid && validIdentity();
      allow delete: if false;
    }

    match /classes/{classId}/academicEvents/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validAcademicEvent(eventId)
        && sameStudentIdentity(request.resource.data.createdByStudentKey, classId)
        && sameStudentIdentity(request.resource.data.audit.studentKey, classId);
      allow update: if signedIn()
        && validAcademicEvent(eventId)
        && request.resource.data.createdByStudentKey == resource.data.createdByStudentKey
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && sameStudentIdentity(request.resource.data.audit.studentKey, classId);
      allow delete: if sameStudentIdentity(resource.data.createdByStudentKey, classId);
    }

    match /classes/{classId}/todos/{todoId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validReminder(todoId);
      allow delete: if false;
    }

    match /classes/{classId}/settings/timetable {
      allow read: if signedIn();
      allow create, update: if signedIn() && validTimetable();
      allow delete: if false;
    }

    match /classes/{classId}/members/{studentId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validMember();
      allow delete: if false;
    }

    match /classes/{classId}/presence/{presenceId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && presenceId == request.resource.data.studentKey
        && validPresence();
      allow delete: if false;
    }

    match /classes/{classId}/originalAttachments/{todoId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validOriginalAttachment();
      allow delete: if false;
    }

    match /classes/{classId}/originalAttachments/{todoId}/chunks/{chunkId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validOriginalChunk();
      allow delete: if false;
    }

    match /students/{studentId}/todoState/{todoId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validPersonalTodoState();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
