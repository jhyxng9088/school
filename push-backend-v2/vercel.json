{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "sh scripts/vercel-ignore-build.sh",
  "functions": {
    "api/reminder-scheduled.js": {
      "maxDuration": 30
    },
    "api/activity-dispatch.js": {
      "maxDuration": 30
    },
    "api/s-hub-ai.js": {
      "maxDuration": 60
    },
    "api/reminder-original.js": {
      "maxDuration": 30
    },
    "api/class-roster.js": {
      "maxDuration": 30
    },
    "api/admin-bootstrap.js": {
      "maxDuration": 30
    },
    "api/admin-console.js": {
      "maxDuration": 60
    },
    "api/admin-class-details.js": {
      "maxDuration": 30
    },
    "api/personal-timetable.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/class-roster-v2",
      "destination": "/api/class-roster?mode=v2"
    },
    {
      "source": "/api/class-roster-repair",
      "destination": "/api/class-roster?mode=repair"
    },
    {
      "source": "/api/reminder-sections",
      "destination": "/api/class-roster?mode=reminder-sections"
    }
  ]
}
