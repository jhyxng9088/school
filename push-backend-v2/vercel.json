{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd .. && npm ci && SHUB_PREVIEW_BASE=/preview/ npm run build && rm -rf push-backend-v2/public/preview && mkdir -p push-backend-v2/public/preview && cp -R dist/. push-backend-v2/public/preview/",
  "rewrites": [
    {
      "source": "/api/preview-v2",
      "destination": "/api/class-roster"
    }
  ],
  "functions": {
    "api/reminder-scheduled.js": {
      "maxDuration": 30
    },
    "api/activity-dispatch.js": {
      "maxDuration": 30
    },
    "api/s-hub-ai.js": {
      "maxDuration": 60
    },
    "api/reminder-original.js": {
      "maxDuration": 30
    },
    "api/class-roster.js": {
      "maxDuration": 30
    },
    "api/class-roster-repair.js": {
      "maxDuration": 30
    },
    "api/admin-bootstrap.js": {
      "maxDuration": 30
    },
    "api/admin-console.js": {
      "maxDuration": 60
    },
    "api/admin-class-details.js": {
      "maxDuration": 30
    },
    "api/personal-timetable.js": {
      "maxDuration": 30
    }
  }
}
